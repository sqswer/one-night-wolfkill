# 依赖（本项目零依赖，仅为保险）
node_modules/
# 敏感配置：TTS key 等放 .env，绝不提交
.env

# 服务端 TTS 缓存（按内容哈希生成的 mp3，自动生成无需提交）
tts-cache/

# Piper 自托管 TTS 的二进制与模型（由 scripts/install_piper.js 下载，体积大、不入库）
tts-bin/

# 临时目录（图片生成等工作目录）
_tmp/
**/_tmp/

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log
*.swp

# 环境变量 / 密钥
.env
.env.*
_validate_presets
_validate_presets.js

# 本地文档，仅本地更新，不推送远程
部署指南.md
官方规则审计报告.md

# 本地工作数据（项目记忆等，不入库）
.workbuddy/

# 本地素材/运营文档：仅本地留存，不推送远程（已从远程删除）
新头像配图/
运营/
